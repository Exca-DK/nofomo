# Preconfigured for instant local dev — `make run` / `make health` work as-is
# from a fresh clone. TEMPO_AGENTIC_CONFIG points at the committed
# infra/local/config.json; its keystore/password/state DB paths are
# bootstrapped under /tmp on first run by `make bootstrap` (see Makefile).
# Never put real secrets in this file for anything beyond local dev.
TEMPO_AGENTIC_CONFIG=infra/local/config.json
UNISWAP_API_KEY=dev-placeholder
GRAPH_API_KEY=dev-placeholder
RUST_LOG=tempo_agentic=info
