# Copy this file to .env beside it before running anything:
#   cp infra/local/.env.example infra/local/.env
#
# .env is not committed. It used to be, so any key that was ever in it has to be
# treated as public and rotated.
TEMPO_AGENTIC_CONFIG=infra/local/config.json
UNISWAP_API_KEY=replace-at-runtime
GRAPH_API_KEY=replace-at-runtime
RUST_LOG=tempo_agentic=info
